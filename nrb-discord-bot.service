[Unit]
Description=NRB Discord Hosting Bot
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
WorkingDirectory=/opt/nrb-discord-bot
ExecStart=/opt/nrb-discord-bot/.venv/bin/python /opt/nrb-discord-bot/bot.py
Restart=always
RestartSec=5
User=root
[Install]
WantedBy=multi-user.target
